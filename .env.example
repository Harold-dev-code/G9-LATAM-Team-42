# Variables para ejecutar Docker Compose localmente con el perfil dev.
# Reemplaza las claves de ejemplo antes de iniciar los servicios.
SPRING_PROFILES_ACTIVE=dev
GEMINI_API_KEY=replace-with-your-gemini-api-key
EXCHANGERATE_API_KEY=replace-with-your-exchangerate-api-key
PUBLIC_IP=http://localhost
VITE_API_URL=http://localhost:8080
